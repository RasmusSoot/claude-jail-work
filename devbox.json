{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "kubectl@1.33.4",
    "kind@0.29.0",
    "gh@2.98.0",
    "k9s@0.51.0",
    "argocd@3.4.6",
    "shellcheck@0.11.0",
    "ruff@0.16.10",
    "python@3.13",
    "gitleaks@8.30.1",
    "hadolint@2.12.0"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "lint": [
        "shellcheck -x -s bash setup-env.sh tools/stack-jail.sh tools/stack-jail-init.sh tools/stack-fork.sh tools/stack-env.sh tools/host-tools.sh tools/pin-aliases.sh tools/kind-stack.sh tools/kdev tools/build-image tools/builder/builder.sh",
        "shellcheck -s sh tools/jail-entrypoint.sh",
        "hadolint Dockerfile tools/builder/Dockerfile",
        "gitleaks git --no-banner --redact .",
        "gitleaks dir --no-banner --redact .",
        "python3 tools/review_md.py",
        "ruff check .",
        "ruff format --check ."
      ],
      "test":      ["python3 -m unittest discover -s tests -v"],
      "review-md": ["python3 tools/review_md.py"],
      "ci":        ["devbox run lint", "devbox run test"]
    }
  }
}
