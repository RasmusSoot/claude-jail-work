# secrets / host-specific
.env
.env.*

# claude state is never under this repo (it lives in ~/claude/jail), but just in case
.claude-data/
.claude-data.*
.claude-data-*
.claude/settings.local.json

# composed session card (written at container start)
/CLAUDE.local.md

# generated from docs/security*.md by tools/review_md.py (lint regenerates it); commit it only
# when a PR review service has to read it from the tree — the --check mode exists for that day
/REVIEW.md

# login jail inbox: uploads AND the private design notes (DESIGN.md) — must stay ignored
/uploads/

# IDE / python
.idea/
__pycache__/
*.pyc

# devbox profile (host tool pins; devbox.lock is committed)
.devbox/

# devbox python plugin venv (host and jail)
.venv/
