#!/usr/bin/env bash
# kdev — the CLIENT DEV cluster, read-only. Plain `kubectl` is the local kind cluster.
# Three layers keep dev safe: the SA's RBAC, this verb allowlist, and the launcher's impersonation
# check before the token is even minted. Secrets are refused here too (read-only is not harmless:
# a dumped secret would land in the LLM context and in telemetry).
set -euo pipefail
cfg="$HOME/.kube/dev.yaml"
[ -f "$cfg" ] || { echo "kdev: no dev credential this session (see the session card)" >&2; exit 2; }
case "${1:-}" in
  get|describe|logs|top|events|explain|api-resources|auth|version|cluster-info) ;;
  *) echo "kdev: '${1:-}' is not a read verb. dev is read-only; kind is plain kubectl." >&2; exit 2 ;;
esac
for a in "$@"; do case "$a" in secret|secrets|secret/*|secrets/*) echo "kdev: secrets are off-limits on dev" >&2; exit 2;; esac; done
echo "▶ cluster: client-dev (read-only)" >&2
exec env KUBECONFIG="$cfg" kubectl --context client-dev "$@"
